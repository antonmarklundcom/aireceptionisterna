# =========================================================================
# AI Receptionisterna — environment configuration
# Copy to .env.local for local dev. In production set these in the
# Hostinger hPanel (Websites > your app > Environment variables).
# Every marketing claim is a toggle: empty / false by default, filled
# only from TRUE values. The site degrades gracefully when each is unset.
# =========================================================================

# --- MINIMUM VIABLE (launch with just these) ---------------------------
NEXT_PUBLIC_SITE_URL=https://aireceptionisterna.se
NEXT_PUBLIC_CONTACT_EMAIL=hej@aireceptionisterna.se
NEXT_PUBLIC_RESPONSE_PROMISE=Vi svarar inom 1 arbetsdag
NEXT_PUBLIC_ORG_NAME=AI Receptionisterna AB
NEXT_PUBLIC_ORG_NR=[KOMPLETTERA]
NEXT_PUBLIC_FSKATT=true
NEXT_PUBLIC_ORT=[KOMPLETTERA]

# pricing (exkl. moms, B2B). Campaign OFF unless explicitly true.
NEXT_PUBLIC_PRICE_ORDINARIE=2995
NEXT_PUBLIC_PRICE_KAMPANJ=1995
NEXT_PUBLIC_CAMPAIGN_ACTIVE=false

# claims OFF by default
NEXT_PUBLIC_GUARANTEE_LINE=

# --- ADD ONE AT A TIME, REDEPLOY EACH ----------------------------------
# Voice AI demo: in-browser widget URL (goal state).
NEXT_PUBLIC_VOICEAI_WIDGET_URL=
# Voice AI demo fallback: a real phone number to call and test.
NEXT_PUBLIC_DEMO_PHONE=
# Enable the "be uppringd" callback form (needs a GHL outbound workflow).
NEXT_PUBLIC_CALLBACK_ENABLED=false
# Calendar embed (GHL calendar or Calendly). Empty => e-post fallback form.
NEXT_PUBLIC_CALENDAR_EMBED_URL=
# External GHL client portal. Hidden in nav if unset.
NEXT_PUBLIC_LOGIN_URL=

# --- SERVER-ONLY (never NEXT_PUBLIC) -----------------------------------
# GoHighLevel inbound webhook for lead fan-out.
GHL_INBOUND_WEBHOOK_URL=
GHL_SANDBOX=true

# Google Sheets backup (service account). PRIVATE_KEY keeps literal \n.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
